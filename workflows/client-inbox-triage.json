      "parameters": {
        "jsCode": "const out = [];\n\n$input.all().forEach((item, i) => {\n  // Get the client info for this email\n  const ctx = $('Parse AI Result').itemMatching(i).json;\n\n  // One output item per attachment\n  for (const key of Object.keys(item.binary || {})) {\n    out.push({\n      json: {\n        file_name: item.binary[key].fileName,\n        drive_folder_id: ctx.drive_folder_id,\n        client_name: ctx.client_name,\n        message_id: ctx.message_id,\n      },\n      binary: { data: item.binary[key] },\n      pairedItem: { item: i },\n    });\n  }\n});\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
