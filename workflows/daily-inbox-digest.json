    {
      "parameters": {
        "jsCode": "const today = $now.setZone('Asia/Manila').toFormat('yyyy-MM-dd');\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => String(r.logged_at || '').startsWith(today));\n\nconst labels = {\n  urgent_deadline: '🚨 Urgent',\n  document_submission: '📄 Documents',\n  billing_question: '💰 Billing',\n  new_client_inquiry: '🆕 New client inquiries',\n  other: '📭 Other',\n};\n\n// Count emails per category\nconst counts = {};\nfor (const r of rows) counts[r.category] = (counts[r.category] || 0) + 1;\n\nlet text = `*Tallymark inbox digest – ${$now.setZone('Asia/Manila').toFormat('ccc, LLL d')}*\\n`;\n\nif (rows.length === 0) {\n  text += 'No client emails today. 🎉';\n} else {\n  text += `${rows.length} emails triaged today\\n\\n`;\n  for (const [key, label] of Object.entries(labels)) {\n    if (counts[key]) text += `${label}: ${counts[key]}\\n`;\n  }\n\n  const urgent = rows.filter(r => r.category === 'urgent_deadline');\n  if (urgent.length) {\n    text += `\\n*Urgent – needs follow-up:*\\n`;\n    urgent.forEach(r => text += `• ${r.client_name}: ${r.summary} (${r.account_manager})\\n`);\n  }\n\n  const leads = rows.filter(r => r.category === 'new_client_inquiry');\n  if (leads.length) {\n    text += `\\n*New leads:*\\n`;\n    leads.forEach(r => text += `• ${r.sender_email}: ${r.summary}\\n`);\n  }\n\n  text += `\\nReply drafts are waiting in Gmail for review.`;\n}\n\nreturn [{ json: { text } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
